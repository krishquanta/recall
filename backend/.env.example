# Google Gemini API Key (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=

# LLM Configuration (Gemini 3.8 Flash is Google's most intelligent Flash model)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=text-embedding-004

# Server Configuration
PORT=3001
UPLOAD_DIR=./uploads
DATA_DIR=./data
